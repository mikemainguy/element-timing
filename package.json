{
  "name": "next-element-timing",
  "version": "0.2.0",
  "description": "Time when tagged elements appear, paint, and become interactive (event handlers live) in Next.js App Router apps.",
  "type": "module",
  "sideEffects": [
    "./dist/client.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "default": "./dist/panel.js"
    },
    "./newrelic": {
      "types": "./dist/newrelic.d.ts",
      "default": "./dist/newrelic.js"
    },
    "./dynatrace": {
      "types": "./dist/dynatrace.d.ts",
      "default": "./dist/dynatrace.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "check:react18": "scripts/check-react18.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "harness": "scripts/harness.sh",
    "verify:vendors": "node --env-file-if-exists=.harness/.env scripts/verify-vendor-events.mjs"
  },
  "peerDependencies": {
    "next": ">=15.3.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^29.1.1",
    "react-dom": "^19.3.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikemainguy/element-timing.git"
  }
}
