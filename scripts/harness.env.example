# Copy to .harness/.env (gitignored) and fill in. Leave a vendor's values empty to skip it.

# --- Browser side (public values: they ship to every visitor anyway) ---
# Also save New Relic's copy-paste browser snippet (Pro or Pro+SPA, agent v1.277.0+) as
# .harness/newrelic-snippet.html. Find it in New Relic under Browser → your app → Settings →
# Application settings → Browser agent → copy/paste JavaScript code.
#
# Dynatrace: only the src URL from a new-RUM web frontend's JavaScript tag
# (https://js-cdn.dynatrace.com/jstag/…), not the whole <script> tag. Find it in Experience Vitals →
# your web frontend → Settings → Manual insertion.
DYNATRACE_RUM_SCRIPT_URL=

# --- Query side (secrets: only scripts/verify-vendor-events.mjs uses these) ---
# New Relic: account id, a *user* API key (NRAK-…), and region us or eu.
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_USER_API_KEY=
NEW_RELIC_REGION=us

# Dynatrace: environment URL like https://abc12345.apps.dynatrace.com and a platform token
# (myaccount.dynatrace.com/platformTokens) with the scope storage:user.events:read.
DYNATRACE_ENVIRONMENT_URL=
DYNATRACE_PLATFORM_TOKEN=
